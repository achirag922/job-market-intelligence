# Docker Compose configuration. Copy to .env (git-ignored) and fill in the blanks.
# Never commit .env, and never put a real secret in this file.

# Spring profile for backend and ETL. "prod" requires every database setting below and
# refuses to start without them; leave it unset for plain `mvn spring-boot:run` locally.
SPRING_PROFILES_ACTIVE=prod
JMIP_LOG_LEVEL=INFO

# PostgreSQL. The password is required and has no default anywhere.
JMIP_DB_NAME=jmip
JMIP_DB_USERNAME=jmip
JMIP_DB_PASSWORD=
JMIP_DB_POOL_SIZE=10
# V10.2: optional pool tuning (milliseconds); see docs/PRODUCTION_DEPLOYMENT.md.
# JMIP_DB_MAX_LIFETIME=1500000
# JMIP_DB_LEAK_DETECTION_THRESHOLD=0
# JMIP_FLYWAY_CONNECT_RETRIES=10
# V10.1: TLS to the database. prefer (default) for the bundled container; require or verify-full for a managed database.
JMIP_DB_SSL_MODE=prefer

# Host ports
JMIP_FRONTEND_PORT=3000
JMIP_BACKEND_PORT=8080
JMIP_DB_EXPOSED_PORT=5434

# The address the browser opens. Baked into the frontend at build time: rebuild the
# frontend image after changing it, and keep its port equal to JMIP_FRONTEND_PORT.
JMIP_PUBLIC_URL=http://localhost:3000
# Required under prod: the browser origins allowed to call the API.
JMIP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# V5 AI assistant. The key is a secret: set it here or in the shell, never in Git.
# Empty key = assistant reports itself unavailable. AI_PROVIDER=stub needs no key.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT=30s

# ETL: which job, and which file under etl/data/raw
JMIP_ETL_JOB=ingestJobPostings
JMIP_ETL_INPUT_FILE=synthetic-job-postings-v1.json
# V9.1: the ETL connector. file (default) reads JMIP_ETL_INPUT_FILE; sample reads the bundled mock
# job-board feed (no network). JMIP_ETL_SAMPLE_RESOURCE (classpath: or file: only) and
# JMIP_ETL_SAMPLE_SOURCE change where it reads from and the source code its jobs get.
JMIP_ETL_CONNECTOR=file

# Abuse protection (per client address, per minute) and the assistant body cap
JMIP_RATE_LIMIT_ENABLED=true
JMIP_RATE_LIMIT_ASSISTANT_PER_MINUTE=20
JMIP_RATE_LIMIT_UPLOADS_PER_MINUTE=10
JMIP_ASSISTANT_MAX_BODY_BYTES=16384

# Password hashing work factor (bcrypt, log2). Raising it slows only new hashes.
JMIP_PASSWORD_BCRYPT_STRENGTH=12

# Browser sign-in (V6.10.2). The session cookie is always HttpOnly.
JMIP_SESSION_COOKIE_SECURE=true
JMIP_SESSION_COOKIE_SAME_SITE=strict
JMIP_SESSION_TIMEOUT=8h
JMIP_RATE_LIMIT_AUTH_PER_MINUTE=10

# Email verification (6-digit codes). JMIP_OTP_SECRET is required: a long random string,
# e.g. from `openssl rand -hex 32`. Delivery: smtp for real email, log for local testing only
# (under prod, log is refused unless every JMIP_CORS_ALLOWED_ORIGINS entry is localhost).
JMIP_OTP_SECRET=
JMIP_VERIFICATION_DELIVERY=log
# Gmail: smtp.gmail.com:587 with an app password (Google Account > Security > App passwords).
JMIP_MAIL_HOST=smtp.gmail.com
JMIP_MAIL_PORT=587
JMIP_MAIL_USERNAME=
JMIP_MAIL_PASSWORD=
JMIP_MAIL_FROM=

# V8.9 admin: comma-separated emails of accounts to make ADMIN at startup. The accounts must exist
# and have verified their email; signup can never create an admin.
JMIP_ADMIN_EMAILS=

# V8.4 job alert digests (daily/weekly emails of new matching jobs). log writes a one-line note
# instead of emailing, for development; smtp sends through the JMIP_MAIL_* server above.
# JMIP_APP_URL is the public frontend address used for the job links in the email.
JMIP_ALERTS_ENABLED=true
JMIP_ALERTS_DELIVERY=log
JMIP_ALERTS_CRON=0 0 * * * *
JMIP_APP_URL=http://localhost:3000
JMIP_ALERTS_MAIL_FROM=

# Resume privacy. The key encrypts stored resume files and extracted text: base64 of 32
# random bytes (`openssl rand -base64 32`). Losing it makes stored resumes unreadable.
JMIP_RESUME_ENCRYPTION_KEY=
# Delete resumes this long after upload (e.g. 365d). 0s keeps them until the owner deletes them.
JMIP_RESUME_RETENTION=0s
# V10.1: resume file store; only local (JMIP_RESUME_DIR, a mounted volume in the cloud).
JMIP_RESUME_STORAGE_TYPE=local

# V7.8 observability. Production logs are JSON lines: ecs (default), logstash or gelf.
JMIP_LOG_FORMAT=ecs
# /actuator/metrics needs this account over HTTP Basic. Leave the password empty to keep
# metrics closed; otherwise use at least 16 characters, e.g. `openssl rand -hex 16`.
JMIP_METRICS_USERNAME=metrics
JMIP_METRICS_PASSWORD=
# Requests at least this slow are logged at INFO (faster ones only at DEBUG).
JMIP_SLOW_REQUEST_THRESHOLD=1s

# HTTPS deployment (docker-compose.https.yml). Local development needs none of this.
# JMIP_PUBLIC_URL and JMIP_CORS_ALLOWED_ORIGINS above must then be https://your-host.
JMIP_TLS_CERT_DIR=
JMIP_HTTP_PORT=80
JMIP_HTTPS_PORT=443
